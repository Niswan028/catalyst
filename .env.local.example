# ====================================================
# CareConnect - Environment Variables Configuration
# ====================================================
# Copy this file to .env.local and fill in your actual credentials.
# NEVER commit .env.local to version control!

# ----------------------------------------------------
# 1. Supabase Credentials (Required)
# ----------------------------------------------------
# Your Supabase Project URL (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anonymous Public Key (safe for client browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Your Supabase Service Role Secret Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Used for administrative operations, RLS bypass in server cron, and signed audio URLs
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ----------------------------------------------------
# 2. Automated Reminders & Cron Secret (Required for Cron)
# ----------------------------------------------------
# Shared secret for securing /api/cron/reminders
CRON_SECRET=your-secure-random-cron-secret-key-12345

# ----------------------------------------------------
# 3. Email Delivery Service (Resend or SMTP)
# ----------------------------------------------------
# Sender email display address
EMAIL_FROM="CareConnect <reminders@careconnect.local>"

# Option A: Standard SMTP (Gmail, SendGrid, Amazon SES, Mailgun, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

# Option B: Resend (Alternative)
# RESEND_API_KEY=re_123456789...
# RESEND_SMTP_HOST=smtp.resend.com
# RESEND_SMTP_USER=resend

# ----------------------------------------------------
# 4. Application Configuration
# ----------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
